# Copy to .env in this directory and edit; `nix run ..#prod` (run from
# here) loads it automatically. Same variables as ../.env.example - this
# copy just has the deployment-relevant ones active by default instead of
# commented out, since "deploy this for real" and "run it on my own
# machine to poke at events" (../dev) want different defaults.

# Matches compotes' own docker-compose.yml convention - see
# ../.env.example for why the default differs (/tmp vs /srv/chatons).
CHATONS_ROOT_DIR=/srv/chatons
APP_NAME=prod

# gunicorn's bind port - keep ../dynamic.yml's backend URL in sync if you
# change this.
#APP_PORT=8000

# Sqlite is fine to start with even here - it's still just a file, now
# under $CHATONS_ROOT_DIR/compotes/$APP_NAME. Switch to Postgres once you
# actually need to:
#DB=postgres
#POSTGRES_DB=compotes
#POSTGRES_USER=compotes
#POSTGRES_HOST=localhost
#POSTGRES_PASSWORD=changeme

# Unlike ../dev (manage.py runserver), gunicorn NEVER serves /static or
# /media itself, regardless of DEBUG - see ../prod/README.md's "Known gap"
# and ../.env.example's note on DEBUG. Set these once that's sorted out
# (nginx, whitenoise, ...) - until then CSS/JS 404 either way, so there's
# no reason to hold off on DEBUG=False specifically:
#DEBUG=False
#SECRET_KEY=change-this-to-a-real-random-secret
