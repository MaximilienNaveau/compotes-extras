# Copy to .env and edit. process-compose loads .env from the current
# directory automatically - nothing else needs to know about this file.

# --- process-compose.yaml's own knobs ---

# Namespaces the sqlite data dir as /tmp/compotes-$APP_NAME, so multiple
# named instances on one machine don't collide. Default: dev
#APP_NAME=dev

# Port for `manage.py runserver`. Default: 8000
#PORT=8000

# process-compose's own HTTP/TUI port (built-in, not specific to this repo -
# only needed if running more than one instance at once). Default: 8080
#PC_PORT_NUM=8080

# --- compotes' settings.py knobs (pass through as-is, nothing extra to wire up) ---

# "postgres" to switch backends; unset/anything else keeps sqlite at
# /tmp/compotes-$APP_NAME/db.sqlite3. Required alongside DB=postgres:
# POSTGRES_DB, POSTGRES_USER, POSTGRES_HOST, POSTGRES_PASSWORD.
#DB=postgres
#POSTGRES_DB=compotes
#POSTGRES_USER=compotes
#POSTGRES_HOST=localhost
#POSTGRES_PASSWORD=changeme

# DEBUG defaults to true (hardcoded insecure SECRET_KEY, no HTTPS
# hardening). Set both of these for anything beyond localhost dev:
#DEBUG=False
#SECRET_KEY=change-this-to-a-real-random-secret

#DOMAIN_NAME=localhost
#ALLOWED_HOST=compotes.localhost
