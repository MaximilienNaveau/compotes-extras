# Copy to .env and edit. process-compose loads .env from the current
# directory automatically - nothing else needs to know about this file.

# --- process-compose.yaml's own knobs ---

# Same variable compotes' own docker-compose.yml uses to root every
# persistent volume (${CHATONS_ROOT_DIR:-/srv/chatons}/compotes/...) - same
# convention here, so a real deployment can point this at /srv/chatons and
# match production exactly. Defaults to /tmp instead of /srv/chatons since
# a normal user can't write to /srv without root - fine for local dev,
# override it for anything else. Default: /tmp
#CHATONS_ROOT_DIR=/srv/chatons

# Namespaces the sqlite data dir as $CHATONS_ROOT_DIR/compotes/$APP_NAME, so
# multiple named instances on one machine don't collide. Default: dev
#APP_NAME=dev

# Port for the dev recipe's `runserver`. Default: 8000
#PORT=8000

# process-compose's own HTTP/TUI port (built-in, not specific to this repo -
# only needed if running more than one instance at once). Default: 8080
#PC_PORT_NUM=8080

# --- compotes' settings.py knobs (pass through as-is, nothing extra to wire up) ---

# "postgres" to switch backends; unset/anything else keeps sqlite at
# $CHATONS_ROOT_DIR/compotes/$APP_NAME/db.sqlite3. Required alongside
# DB=postgres: POSTGRES_DB, POSTGRES_USER, POSTGRES_HOST, POSTGRES_PASSWORD.
#DB=postgres
#POSTGRES_DB=compotes
#POSTGRES_USER=compotes
#POSTGRES_HOST=localhost
#POSTGRES_PASSWORD=changeme

# DEBUG defaults to true (hardcoded insecure SECRET_KEY, no HTTPS
# hardening). Set both of these for anything beyond localhost dev:
#DEBUG=False
#SECRET_KEY=change-this-to-a-real-random-secret
#
# CAUTION: `runserver` (what process-compose.yaml runs) only auto-serves
# static/media files while DEBUG=True. In compotes' own
# docker-compose.yml, gunicorn (not runserver) is paired with a separate
# nginx container specifically to serve /static and /media once DEBUG is
# off. Setting DEBUG=False here without adding something equivalent means
# CSS/JS will 404. Fine to leave DEBUG=True even for a "real" deployment
# until that's sorted out - it costs you HTTPS hardening and a fixed
# SECRET_KEY, not functionality.

#DOMAIN_NAME=localhost
#ALLOWED_HOST=compotes.localhost
