# Copy to .env in this directory and edit; `docker compose up -d --build`
# (run from here) loads it automatically - same env_file compotes' own
# docker-compose.yml uses, shared by both the app and postgres services.

# Real domain for a live deployment - the app ends up reachable at
# compotes.$DOMAIN_NAME (settings.py's own ALLOWED_HOSTS default), and the
# Traefik router rules in docker-compose.yml's labels are built from this
# too. Requires a Traefik instance already watching the external "web"
# Docker network with its *Docker* provider enabled (`docker network
# create web` first if it doesn't exist yet) - a different integration
# than ../prod/'s Traefik *file* provider setup, matching how compotes'
# own docker-compose.yml does it.
DOMAIN_NAME=example.org

# Required - settings.py has no fallback for this one, and the official
# postgres image reads the same variable directly (both services share
# this file via env_file). POSTGRES_DB/POSTGRES_USER default to "postgres"
# on both sides if left unset (DB=postgres, set in docker-compose.yml
# itself), so there's nothing else to configure for Postgres.
POSTGRES_PASSWORD=changeme

# Unlike ../prod/ (gunicorn with no nginx/whitenoise in front of it -
# "known gap" in ../prod/README.md), nginx here really does serve
# /static and /media once DEBUG is off, so there's no reason to leave
# DEBUG=True for a real deployment:
DEBUG=False
SECRET_KEY=change-this-to-a-real-random-secret

# Same CHATONS_ROOT_DIR convention as ../prod/.env.example and compotes'
# own docker-compose.yml - roots the Postgres data volume and the
# static/media volume shared between app and nginx.
CHATONS_ROOT_DIR=/srv/chatons
