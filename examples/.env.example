# Copy to .env (in the directory you'll run `nix run` from) and edit.
# Same variables as ../.env.example - this copy just has the
# deployment-relevant ones active by default instead of commented out,
# since "deploy this somewhere" and "run it on my own machine to poke at
# events" (../dev) want different defaults.

# Matches compotes' own docker-compose.yml convention - see
# ../.env.example for why the default differs (/tmp vs /srv/chatons).
CHATONS_ROOT_DIR=/srv/chatons
APP_NAME=prod

# Sqlite is fine to start with even here - it's still just a file, now
# under $CHATONS_ROOT_DIR/compotes/$APP_NAME. Switch to Postgres once you
# actually need to:
#DB=postgres
#POSTGRES_DB=compotes
#POSTGRES_USER=compotes
#POSTGRES_HOST=localhost
#POSTGRES_PASSWORD=changeme

# Left as DEBUG=True (i.e. unset) on purpose, even though this is the
# "deployment" example: this setup runs manage.py runserver, which only
# auto-serves static/media files while DEBUG=True. Setting DEBUG=False
# here without also adding something to serve /static and /media (nginx,
# whitenoise, ...) means CSS/JS 404 - see ../.env.example for the full
# explanation. Uncomment these once that's sorted out:
#DEBUG=False
#SECRET_KEY=change-this-to-a-real-random-secret
