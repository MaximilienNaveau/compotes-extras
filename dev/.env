# Local dev instance config. Run from here:
#   cd dev && nix run ..#dev -- up -D
# (.. so it uses this checkout's flake, not a fetched github: copy - for
# active work on compotes-extras itself, not a standalone deployment; see
# ../prod/ for that, or github:MaximilienNaveau/compotes-extras#dev from
# a machine that doesn't have this cloned.)
#
# APP_NAME and PORT are set explicitly here just to be self-documenting -
# both already match process-compose.yaml's own defaults. Data ends up at
# /tmp/compotes/dev/db.sqlite3 (CHATONS_ROOT_DIR defaults to /tmp - see
# ../.env.example). The app is at http://compotes.localhost:8000/ once
# started.
APP_NAME=dev
PORT=8000
